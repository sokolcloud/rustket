      </presentation>
      <presentation id="AllowPasswordLogin" />
      <presentation id="AllowTokenLogin" />
      <presentation id="AllowSecretsFile" />
      <presentation id="NotificationPreview" />
      <presentation id="HardwareAcceleration" />
      <presentation id="LaunchAtLogin" />
      <presentation id="OrganizationName">
        <textBox refId="OrganizationName">
          <label>Название организации:</label>
        </textBox>
      </presentation>
