# Copy to .env (git-ignored) and fill in. Read by docker compose and by
# setup.sh / seed.sh (plain KEY=value lines, no shell expansion).

# Proxy in front of Rocket.Chat (README.md):
# - caddy (default): this VM terminates TLS with a Let's Encrypt certificate,
#   ports 80 and 443 open, A and AAAA records to the VM;
# - tunnel: a Cloudflare Tunnel from this host (tunnel.sh), nothing listens
#   publicly. Also uncomment COMPOSE_FILE below (the scripts stop without
#   it), so hand-typed `docker compose` commands leave Caddy out too.
REVIEW_PROXY=caddy
#COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
# Tunnel mode only: the loopback port Rocket.Chat is published on for
# cloudflared (127.0.0.1 only), and the name of the Cloudflare Tunnel, which
# also names its config (~/.cloudflared/<name>.yml) and systemd user unit.
#REVIEW_TUNNEL_PORT=3010
#REVIEW_TUNNEL_NAME=rustket-review

# Public hostname of the review workspace. Caddy mode: needs A and AAAA records
# to this VM. Tunnel mode: tunnel.sh creates its CNAME in the Cloudflare zone.
REVIEW_HOST=review.example.com
# Caddy mode only: contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
# Caddy mode only: uncomment for a first dry run to avoid Let's Encrypt rate
# limits. The certificate is then untrusted and setup.sh stops at the wait;
# switch back, `docker compose up -d caddy`, rerun setup.sh.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Image tags. Keep Rocket.Chat equal to dev/docker-compose.yml, the version the
# app is tested against, and do not change them while a review is open.
ROCKETCHAT_IMAGE=rocketchat/rocket.chat:8.9.1
MONGO_IMAGE=mongo:7.0
CADDY_IMAGE=caddy:2-alpine

# Support address printed in the review notes.
REVIEW_SUPPORT_EMAIL=support@example.com
# End-to-end encryption and the "secure-notes" room (see README.md, "E2E").
REVIEW_E2E=true
# Upload limit in bytes (5 MB).
REVIEW_MAX_UPLOAD_BYTES=5242880
# Let users delete their own account. setup.sh recreates the review accounts.
REVIEW_ALLOW_DELETE_OWN_ACCOUNT=false
# Comma-separated list for Rocket.Chat's bad-words filter.
REVIEW_BAD_WORDS=fuck,fucking,shit,bullshit,bitch,bastard,asshole,cunt,dick,slut,whore,retard
