# Copy to .env (git-ignored) and fill in. Read by docker compose and by
# setup.sh / seed.sh (plain KEY=value lines, no shell expansion).

# Public hostname of the review workspace. Needs A and AAAA records to this VM.
REVIEW_HOST=review.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
# Uncomment for a first dry run to avoid Let's Encrypt rate limits. The
# certificate is then untrusted and setup.sh stops at the wait; switch back,
# `docker compose up -d caddy`, rerun setup.sh.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Image tags. Keep Rocket.Chat equal to dev/docker-compose.yml, the version the
# app is tested against, and do not change them while a review is open.
ROCKETCHAT_IMAGE=rocketchat/rocket.chat:8.9.1
MONGO_IMAGE=mongo:7.0
CADDY_IMAGE=caddy:2-alpine

# Support address printed in the review notes.
REVIEW_SUPPORT_EMAIL=support@example.com
# End-to-end encryption and the "secure-notes" room (see README.md, "E2E").
REVIEW_E2E=true
# Upload limit in bytes (5 MB).
REVIEW_MAX_UPLOAD_BYTES=5242880
# Let users delete their own account. setup.sh recreates the review accounts.
REVIEW_ALLOW_DELETE_OWN_ACCOUNT=false
# Comma-separated list for Rocket.Chat's bad-words filter.
REVIEW_BAD_WORDS=fuck,fucking,shit,bullshit,bitch,bastard,asshole,cunt,dick,slut,whore,retard
